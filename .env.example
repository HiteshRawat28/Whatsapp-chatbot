# Application
PORT=8787
PUBLIC_APP_URL=http://localhost:5173

# "demo" runs completely locally. Use "meta" after adding Cloud API credentials.
WHATSAPP_PROVIDER=demo

# Meta WhatsApp Cloud API (server-side only)
# Copy the current version shown by Meta, using the exact vXX.X format.
META_GRAPH_API_VERSION=vXX.X
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=

# Choose this value yourself and enter the same value in Meta webhook setup.
META_WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string

# Meta App Dashboard > App settings > Basic > App secret
META_APP_SECRET=

# Business identity
BUSINESS_NAME=VoltAssist Energy
ESCALATION_PHONE=917455085375
